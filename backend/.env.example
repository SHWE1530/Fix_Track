# FixTrack Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database (Leave blank to use automatic in-memory mock engine with persistent fallback, or set to standard mongodb URI)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=fixtrack_db
USE_MOCK_DB_IF_UNAVAILABLE=true

# Security & Authentication
JWT_SECRET=super_secret_jwt_signing_key_min_32_characters_random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS & Frontend Origins (comma separated)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.pdf

# Rate Limiting
AUTH_RATE_LIMIT_PER_MINUTE=15
